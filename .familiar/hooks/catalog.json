{
  "schema": "1.0",
  "note": "Source of truth for install_hooks.py. A host with no entry for a hook is unsupported for it; Gemini CLI has no project-level hook file, so it is never written to (see INSTALL-HOOKS.md).",
  "hooks": [
    {
      "id": "guard-writes",
      "group": "guards",
      "applies_to": "project",
      "title": "Write guard",
      "summary": "Denies writes outside the project, to 1-Inputs/ or to .familiar/ (CORE-WORKSPACE-SILO, CORE-COPY-ON-EDIT, CORE-INSTRUCTIONS-READONLY).",
      "status": "verified on Claude Code",
      "hosts": {
        "claude": [
          {
            "event": "PreToolUse",
            "matcher": "Write|Edit|Bash",
            "script": "guards.py",
            "args": [
              "--guard",
              "writes",
              "--host",
              "claude"
            ]
          }
        ],
        "codex": [
          {
            "event": "PreToolUse",
            "matcher": "Bash",
            "script": "guards.py",
            "args": [
              "--guard",
              "writes",
              "--host",
              "codex"
            ]
          }
        ]
      }
    },
    {
      "id": "guard-delete",
      "group": "guards",
      "applies_to": "project",
      "title": "Delete guard",
      "summary": "Denies a shell delete unless every target is in scratch; anything it cannot parse with confidence is denied (CORE-NO-DELETE).",
      "status": "verified on Claude Code",
      "hosts": {
        "claude": [
          {
            "event": "PreToolUse",
            "matcher": "Bash",
            "script": "guards.py",
            "args": [
              "--guard",
              "delete",
              "--host",
              "claude"
            ]
          }
        ],
        "codex": [
          {
            "event": "PreToolUse",
            "matcher": "Bash",
            "script": "guards.py",
            "args": [
              "--guard",
              "delete",
              "--host",
              "codex"
            ]
          }
        ]
      }
    },
    {
      "id": "guard-reads",
      "group": "guards",
      "applies_to": "project",
      "title": "Read guard",
      "summary": "Keeps reads inside the project folder, with narrow named exceptions (scratch, and the ~/.familiar/ files familiar's skills declare).",
      "status": "verified on Claude Code",
      "hosts": {
        "claude": [
          {
            "event": "PreToolUse",
            "matcher": "Read|Grep|Glob|Bash",
            "script": "guards.py",
            "args": [
              "--guard",
              "reads",
              "--host",
              "claude"
            ]
          }
        ],
        "codex": [
          {
            "event": "PreToolUse",
            "matcher": "Bash",
            "script": "guards.py",
            "args": [
              "--guard",
              "reads",
              "--host",
              "codex"
            ]
          }
        ]
      }
    },
    {
      "id": "guard-boundary",
      "group": "guards",
      "applies_to": "project",
      "title": "Boundary guard",
      "summary": "Inside the maintainer checkout, refuses to scaffold a .familiar-project marker; elsewhere, keeps maintainer-only tooling from running against the wrong tree.",
      "status": "untested-live",
      "hosts": {
        "claude": [

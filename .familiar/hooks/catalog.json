    {
      "id": "session-title",
      "group": "titles",
      "applies_to": "project",
      "title": "Session title",
      "summary": "Titles each Claude Code session \"(<signature>) <project name>\" so Remote Control on a phone or the web lists it by project instead of a generic machine-and-word name.",
      "status": "verified on Claude Code",
      "hosts": {
        "claude": [
          {
            "event": "SessionStart",
            "matcher": "startup|resume",
            "script": "session_title.py",
            "args": []
